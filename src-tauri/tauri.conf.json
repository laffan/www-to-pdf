{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "www-to-pdf",
  "version": "0.1.0",
  "identifier": "com.laffan.wwwtopdf",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "www → pdf",
        "width": 480,
        "height": 720,
        "minWidth": 360,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
